#!/bin/bash
# RPM %post scriptlet for Focus Bear.
# $1 = 1 on first install, $1 = 2 on upgrade. The body is idempotent, so we
# don't branch on it — we just (re)create the wrapper, desktop entry patch,
# and native messaging manifest every time the package is laid down.
set -e

APP_DIR="/opt/Focus Bear"
NATIVE_HOST_DEST="/usr/local/bin/focusbear-native-host"
MANIFEST_NAME="com.focusbear.native_host.json"
# Fedora/RHEL-packaged Firefox is built with --libdir=/usr/lib64 and scans
# /usr/lib64/mozilla/native-messaging-hosts on x86_64; Mozilla's own tarball
# and openSUSE's Firefox scan /usr/lib. Write to both so the manifest is
# discovered regardless of which Firefox build is installed.
FIREFOX_MANIFEST_DIRS="/usr/lib/mozilla/native-messaging-hosts /usr/lib64/mozilla/native-messaging-hosts"

# chrome-sandbox must be SUID root for Electron's process sandbox to work
chmod 4755 "${APP_DIR}/chrome-sandbox" || true

# Wrapper at /usr/bin/focusbear. --no-sandbox is required because the install
# path "/opt/Focus Bear/" contains a space: Electron's LaunchProcess splits it,
# chrome-sandbox is never found, and the user-namespace fallback is denied by
# the unprivileged_userns AppArmor profile on some kernels.
cat > /usr/bin/focusbear << 'WRAPPER'
#!/bin/sh
exec "/opt/Focus Bear/focusbear" --no-sandbox "$@"
WRAPPER
chmod 755 /usr/bin/focusbear

# Patch the desktop entry Exec to use the wrapper (clean path, no spaces).
DESKTOP_FILE="/usr/share/applications/focusbear.desktop"
if [ -f "$DESKTOP_FILE" ]; then
    sed -i 's|^Exec=.*|Exec=/usr/bin/focusbear %U|' "$DESKTOP_FILE"
fi

if hash update-desktop-database 2>/dev/null; then
    update-desktop-database --quiet
fi

# ── Native Messaging Host ────────────────────────────────────────────────────

HOST_JS="${APP_DIR}/resources/native-messaging/host.js"

if [ ! -f "$HOST_JS" ]; then
    echo "Warning: native messaging host script not found; browser URL blocking will not work." >&2
    exit 0
fi

cat > "$NATIVE_HOST_DEST" << EOF
#!/bin/sh
exec node "$HOST_JS" "\$@"
EOF
chmod 755 "$NATIVE_HOST_DEST"

MANIFEST_SRC="${APP_DIR}/resources/native-messaging/$MANIFEST_NAME"
for dir in $FIREFOX_MANIFEST_DIRS; do
    mkdir -p "$dir"
    if [ -f "$MANIFEST_SRC" ]; then
        cp "$MANIFEST_SRC" "$dir/$MANIFEST_NAME"
    else
        cat > "$dir/$MANIFEST_NAME" << 'MANIFEST'
{
  "name": "com.focusbear.native_host",
  "description": "Focus Bear Native Messaging Host",
  "path": "/usr/local/bin/focusbear-native-host",
  "type": "stdio",
  "allowed_extensions": ["focusbear@focusbear.io"]
}
MANIFEST
    fi
done

echo "Focus Bear installed. Extension files are at: ${APP_DIR}/resources/extension/"

# ── systemd user service ─────────────────────────────────────────────────────
# Installed system-wide at /usr/lib/systemd/user/ so any logged-in user can
# opt in with `systemctl --user enable --now focusbear`. We deliberately do
# NOT auto-enable: this script runs as root and cannot cleanly enable a
# per-user unit on behalf of arbitrary users on the machine.
SYSTEMD_UNIT_SRC="${APP_DIR}/resources/focusbear.service"
SYSTEMD_UNIT_DEST="/usr/lib/systemd/user/focusbear.service"
if [ -f "$SYSTEMD_UNIT_SRC" ]; then
    mkdir -p /usr/lib/systemd/user
    cp "$SYSTEMD_UNIT_SRC" "$SYSTEMD_UNIT_DEST"
    chmod 644 "$SYSTEMD_UNIT_DEST"
    echo "To run Focus Bear as a background service that restarts on crash:"
    echo "  systemctl --user daemon-reload"
    echo "  systemctl --user enable --now focusbear"
fi
