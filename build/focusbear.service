[Unit]
Description=Focus Bear distraction blocker
Documentation=https://github.com/Focus-Bear/Linux-App
# A graphical session must exist before Focus Bear can show its tray icon or
# main window. PartOf ties the lifecycle: when the user logs out and the
# graphical session ends, the service is stopped (not just left orphaned).
After=graphical-session.target
PartOf=graphical-session.target
# Don't fail the unit on a fresh install before the wrapper exists.
ConditionPathExists=/usr/bin/focusbear
# Cap the restart loop so a persistent crash bug can't burn CPU forever.
# Five restarts in two minutes, then systemd gives up until the user
# investigates with `systemctl --user status focusbear`. These keys live
# in [Unit] (not [Service]) since systemd v230.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/focusbear --hidden
# Restart only on abnormal exit (signal / non-zero code). A clean quit from
# the tray menu is an intentional user action and should NOT respawn.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
