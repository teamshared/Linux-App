#!/bin/bash
set -e

APP_DIR="/opt/Focus Bear"
NATIVE_HOST_DEST="/usr/local/bin/focusbear-native-host"
FIREFOX_MANIFEST_DIR="/usr/lib/mozilla/native-messaging-hosts"
MANIFEST_NAME="com.focusbear.native_host.json"

# ── Dependency Checker ───────────────────────────────────────────────────────
# Check for required dependencies and prompt to install if missing
check_and_install_dependencies() {
    echo ""
    echo "╔════════════════════════════════════════════════════════════════╗"
    echo "║          Focus Bear - Dependency Checker                       ║"
    echo "╚════════════════════════════════════════════════════════════════╝"
    echo ""

    # Detect package manager
    if command -v apt-get &> /dev/null; then
        PKG_MANAGER="apt"
        INSTALL_CMD="apt-get install -y"
        UPDATE_CMD="apt-get update"
        # Debian/Ubuntu packages for Electron app
        PACKAGES=(
            "python3"
            "nodejs"
            "zip"
            "libgtk-3-0"
            "libglib2.0-0"
            "libx11-6"
            "libdbus-1-3"
            "libfontconfig1"
            "libfreetype6"
            "libnotify4"
            "libnss3"
            "libxss1"
            "libxtst6"
            "xdg-utils"
            "libatspi2.0-0"
            "libuuid1"
            "libsecret-1-0"
        )
    elif command -v dnf &> /dev/null; then
        PKG_MANAGER="dnf"
        INSTALL_CMD="dnf install -y"
        UPDATE_CMD="dnf check-update || true"
        # Fedora/RHEL packages for Electron app
        PACKAGES=(
            "python3"
            "nodejs"
            "zip"
            "gtk3"
            "glib2"
            "libX11"
            "dbus"
            "fontconfig"
            "freetype"
            "libnotify"
            "nss"
            "libXss"
            "libXtst"
            "xdg-utils"
            "at-spi2-core"
            "util-linux"
            "libsecret"
        )
    elif command -v zypper &> /dev/null; then
        PKG_MANAGER="zypper"
        INSTALL_CMD="zypper install -y"
        UPDATE_CMD="zypper refresh || true"
        # openSUSE packages for Electron app
        PACKAGES=(
            "python3"
            "nodejs"
            "zip"
            "gtk3"
            "glib2"
            "libX11-6"
            "dbus-1"
            "fontconfig"
            "freetype2"
            "libnotify1"
            "mozilla-nss"
            "libxss1"
            "libXtst6"
            "xdg-utils"
            "at-spi2-core"
            "util-linux"
            "libsecret-1-0"
        )
    elif command -v pacman &> /dev/null; then
        PKG_MANAGER="pacman"
        INSTALL_CMD="pacman -S --noconfirm"
        UPDATE_CMD="pacman -Sy"
        # Arch Linux packages for Electron app
        PACKAGES=(
            "python"
            "nodejs"
            "zip"
            "gtk3"
            "glib2"
            "libx11"
            "dbus"
            "fontconfig"
            "freetype2"
            "libnotify"
            "nss"
            "libxss"
            "libxtst"
            "xdg-utils"
            "at-spi2-core"
            "util-linux"
            "libsecret"
        )
    else
        echo "Warning: No supported package manager found (apt, dnf, zypper, pacman)"
        echo "Please install dependencies manually if the app doesn't work."
        return 0
    fi

    echo "Detected package manager: $PKG_MANAGER"
    echo ""

    # Check which packages are missing
    MISSING=()
    for pkg in "${PACKAGES[@]}"; do
        if ! $INSTALL_CMD --dry-run "$pkg" &>/dev/null 2>&1; then
            MISSING+=("$pkg")
        fi
    done

    if [ ${#MISSING[@]} -eq 0 ]; then
        echo "✓ All dependencies are already installed"
        echo ""
        return 0
    fi

    echo "⚠ Found missing dependencies: ${#MISSING[@]}"
    echo ""
    for pkg in "${MISSING[@]}"; do
        echo "  - $pkg"
    done
    echo ""

    read -p "Install missing dependencies now? (requires sudo) [Y/n] " -r -t 30 || REPLY="Y"
    echo ""

    if [[ "$REPLY" =~ ^[Yy]$ ]]; then
        echo "Updating package manager..."
        $UPDATE_CMD || true

        echo "Installing dependencies..."
        if $INSTALL_CMD "${MISSING[@]}"; then
            echo "✓ Dependencies installed successfully!"
            echo ""
        else
            echo "✗ Failed to install some dependencies"
            echo "You can install them manually with:"
            echo "  sudo $INSTALL_CMD ${MISSING[@]}"
            echo ""
        fi
    else
        echo "Skipped dependency installation"
        echo "You can install them later with:"
        echo "  sudo $INSTALL_CMD ${MISSING[@]}"
        echo ""
    fi
}

# Run dependency checker
check_and_install_dependencies

# chrome-sandbox must be SUID root for Electron's process sandbox to work
chmod 4755 "${APP_DIR}/chrome-sandbox" || true

# Create a wrapper script at /usr/bin/focusbear instead of a plain symlink.
# --no-sandbox is required because the install path "/opt/Focus Bear/" contains
# a space: Electron's internal LaunchProcess splits it, so chrome-sandbox is
# never found, and the user-namespace fallback is denied by AppArmor's
# unprivileged_userns profile (sys_admin capability) on this kernel.
cat > /usr/bin/focusbear << 'WRAPPER'
#!/bin/sh
export LD_LIBRARY_PATH="/opt/Focus Bear/resources/lib:$LD_LIBRARY_PATH"
exec "/opt/Focus Bear/focusbear" --no-sandbox "$@"
WRAPPER
chmod 755 /usr/bin/focusbear

# Patch the desktop entry Exec to use the wrapper (clean path, no spaces).
DESKTOP_FILE="/usr/share/applications/focusbear.desktop"
if [ -f "$DESKTOP_FILE" ]; then
    sed -i 's|^Exec=.*|Exec=/usr/bin/focusbear %U|' "$DESKTOP_FILE"
fi

# Refresh desktop application database
if hash update-desktop-database 2>/dev/null; then
    update-desktop-database --quiet
fi

# ── Native Messaging Host ────────────────────────────────────────────────────

HOST_JS="${APP_DIR}/resources/native-messaging/host.js"

if [ ! -f "$HOST_JS" ]; then
    echo "Warning: native messaging host script not found; browser URL blocking will not work." >&2
    exit 0
fi

# Wrapper script at the path Firefox expects (set in the manifest)
cat > "$NATIVE_HOST_DEST" << EOF
#!/bin/sh
exec "${APP_DIR}/resources/node/bin/node" "${APP_DIR}/resources/native-messaging/host.js" "\$@"
EOF
chmod 755 "$NATIVE_HOST_DEST"

# System-wide Firefox manifest (applies to all users without per-user setup)
mkdir -p "$FIREFOX_MANIFEST_DIR"
MANIFEST_SRC="${APP_DIR}/resources/native-messaging/$MANIFEST_NAME"
if [ -f "$MANIFEST_SRC" ]; then
    cp "$MANIFEST_SRC" "$FIREFOX_MANIFEST_DIR/$MANIFEST_NAME"
else
    cat > "$FIREFOX_MANIFEST_DIR/$MANIFEST_NAME" << 'MANIFEST'
{
  "name": "com.focusbear.native_host",
  "description": "Focus Bear Native Messaging Host",
  "path": "/usr/local/bin/focusbear-native-host",
  "type": "stdio",
  "allowed_extensions": ["focusbear@focusbear.io"]
}
MANIFEST
fi

# ── systemd user service ─────────────────────────────────────────────────────
# Installed system-wide at /usr/lib/systemd/user/ so any logged-in user can
# opt in with `systemctl --user enable --now focusbear`. We deliberately do
# NOT auto-enable: this script runs as root and cannot cleanly enable a
# per-user unit on behalf of arbitrary users on the machine.
SYSTEMD_UNIT_SRC="${APP_DIR}/resources/focusbear.service"
SYSTEMD_UNIT_DEST="/usr/lib/systemd/user/focusbear.service"
if [ -f "$SYSTEMD_UNIT_SRC" ]; then
    mkdir -p /usr/lib/systemd/user
    cp "$SYSTEMD_UNIT_SRC" "$SYSTEMD_UNIT_DEST"
    chmod 644 "$SYSTEMD_UNIT_DEST"
fi

# ── Print installation success message ────────────────────────────────────────
echo ""
echo "╔════════════════════════════════════════════════════════════════╗"
echo "║          ✓ Focus Bear Installed Successfully!                  ║"
echo "╚════════════════════════════════════════════════════════════════╝"
echo ""
echo "📱 Next Steps:"
echo ""
echo "1️⃣  Start Focus Bear:"
echo "    focusbear"
echo ""
echo "2️⃣  Install Firefox Extension:"
echo "    a) Open Firefox and go to: about:debugging#/runtime/this-firefox"
echo "    b) Click 'Load Temporary Add-on'"
echo "    c) Navigate to: ~/.local/share/focusbear/"
echo "    d) Select: focusbear-extension.xpi"
echo ""
echo "3️⃣  (Optional) Enable Background Service:"
echo "    Run these commands to start Focus Bear in the background:"
echo "    systemctl --user daemon-reload"
echo "    systemctl --user enable --now focusbear"
echo ""
echo "4️⃣  Verify Extension is Running:"
echo "    - In Firefox, go to about:extensions"
echo "    - Look for 'Focus Bear' extension"
echo "    - It should show as 'Temporary' (will be permanent after installation)"
echo ""
echo "📝 Extension Location: ~/.local/share/focusbear/focusbear-extension.xpi"
echo "📝 Config Location:    ~/.local/share/focusbear/"
echo ""
echo "🆘 Need Help? Visit: https://focusbear.io/help"
echo ""
