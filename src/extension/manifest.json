{
  "manifest_version": 2,
  "name": "Focus Bear Blocker",
  "version": "1.0.0",
  "description": "Displays and enforces block lists from Focus Bear app",
  "author": "Focus Bear",

  "browser_specific_settings": {
    "gecko": {
      "id": "focusbear@focusbear.io",
      "strict_min_version": "50.0"
    }
  },

  "permissions": [
    "nativeMessaging",
    "storage",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ],

  "web_accessible_resources": [
    "blocked.html"
  ],

  "background": {
    "scripts": ["background.js"]
  },

  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Focus Bear Blocker",
    "default_icon": {
      "48": "icon.png"
    }
  },

  "icons": {
    "48": "icon.png"
  }
}
