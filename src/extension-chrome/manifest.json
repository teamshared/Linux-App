{
  "manifest_version": 3,
  "name": "Focus Bear Blocker",
  "version": "1.0.0",
  "description": "Displays and enforces block lists from Focus Bear app",
  "author": "Focus Bear",
  "key": "",

  "permissions": [
    "nativeMessaging",
    "storage",
    "tabs",
    "declarativeNetRequest",
    "alarms",
    "offscreen"
  ],
  "host_permissions": ["<all_urls>"],

  "web_accessible_resources": [{
    "resources": ["blocked.html"],
    "matches": ["<all_urls>"]
  }],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "Focus Bear Blocker",
    "default_icon": {
      "48": "icon.png"
    }
  },

  "icons": {
    "48": "icon.png"
  }
}
