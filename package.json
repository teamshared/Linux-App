{
  "name": "focusbear",
  "productName": "Focus Bear",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/electron/main.js",
  "scripts": {
    "start": "concurrently \"npm run dev:vite\" \"npm run backend\" \"wait-on http://localhost:5173 && electron .\"",
    "start:prod": "concurrently \"npm run dev:vite:prod\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:vite": "vite --mode development",
    "dev:vite:prod": "vite --mode production",
    "backend": "cd backend && node server.js",
    "build": "vite build --mode production",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "package": "npm run build && electron-builder --linux AppImage",
    "package:all": "npm run build && electron-builder --linux AppImage deb",
    "package:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "auth0": "^4.29.0",
    "dotenv": "^17.2.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "electron": "^37.3.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "vite": "^7.1.5",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "io.focusbear.app",
    "productName": "Focus Bear",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "maintainer": "your-email@example.com",
      "desktop": {
        "Name": "Focus Bear",
        "Comment": "Productivity and focus management tool",
        "Categories": "Utility;Productivity;",
        "Keywords": "productivity;focus;blocking;",
        "MimeType": "x-scheme-handler/focusbear;"
      },
      "executableName": "focusbear"
    },
    "protocols": [
      {
        "name": "Focus Bear Protocol",
        "schemes": [
          "focusbear"
        ]
      }
    ],
    "files": [
      "dist-react/**/*",
      "src/electron/**/*",
      "src/ui/**/*",
      "public/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/python",
        "to": "python",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "fileAssociations": [
      {
        "ext": "focusbear",
        "name": "Focus Bear Protocol",
        "role": "Viewer"
      }
    ]
  }
}
