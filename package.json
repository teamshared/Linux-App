{
  "name": "package.json",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "src/electron/main.js",
  "scripts": {
    "start": "concurrently \"npm run dev:vite\" \"npm run backend\" \"wait-on http://localhost:5173 && electron .\"",
    "start:prod": "concurrently \"npm run dev:vite:prod\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:vite": "vite --mode development",
    "dev:vite:prod": "vite --mode production", 
    "build": "vite build --mode production",
    "backend": "cd backend && node server.js",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@auth0/auth0-spa-js": "^2.4.1",
    "auth0": "^4.29.0",
    "dotenv": "^17.2.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "electron": "^37.3.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "vite": "^7.1.5",
    "wait-on": "^8.0.4"
  }
}
